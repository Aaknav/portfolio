# Contact form delivery. Copy this file to .env.local and fill in.
# Without RESEND_API_KEY the form fails gracefully and points visitors at the
# direct email address instead.

RESEND_API_KEY=
# Where enquiries are delivered. Defaults to the address in lib/site.ts.
CONTACT_TO_EMAIL=
# Must be a verified sender in Resend. Defaults to enquiries@resend.dev.
CONTACT_FROM_EMAIL=
