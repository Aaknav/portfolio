# Contact form delivery. Copy this file to .env.local and fill in.
#
# Every variable here is optional. Without RESEND_API_KEY the form fails
# gracefully and points visitors at the direct email address instead.
#
# Values are validated at startup by lib/env.ts — a key from the wrong service
# or a typo'd address fails immediately rather than at send time in production.
# Empty values (as shipped below) are read as "not configured", not as "".

# Resend API key. Must start with `re_`.
RESEND_API_KEY=
# Where enquiries are delivered. Must be a valid address.
# Defaults to the address in lib/site.ts.
CONTACT_TO_EMAIL=
# Must be a verified sender in Resend, and a valid address.
# Defaults to enquiries@resend.dev.
CONTACT_FROM_EMAIL=
